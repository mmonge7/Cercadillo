---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe o se ha movido.">
  <section class="container-editorial flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-display text-6xl font-bold text-piedra-300 dark:text-piedra-500">404</p>
    <h1 class="mt-4 font-serif text-3xl font-bold text-tinta dark:text-pergamino-muted">No hemos encontrado esta página</h1>
    <p class="mt-3 max-w-md text-tinta/70 dark:text-pergamino-muted/70">
      Puede que el enlace esté roto o la página se haya movido. Vuelve al inicio o explora el archivo.
    </p>
    <a href={base} class="btn-primary mt-8">Volver al inicio</a>
  </section>
</BaseLayout>
