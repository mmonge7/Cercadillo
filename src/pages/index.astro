---
import BaseLayout from '../layouts/BaseLayout.astro';
import CounterGrid from '../components/CounterGrid.astro';
import { BookOpen, Map, Users, BookMarked, Info, PartyPopper, Church, Shield, MapPin, History, Library } from 'lucide-react';

const base = import.meta.env.BASE_URL;

const sections = [
  {
    href: 'historia',
    icon: History,
    title: 'Historia',
    description: 'Eje cronológico del pueblo, de la repoblación medieval del siglo XI a la actualidad.',
  },
  {
    href: 'lugares',
    icon: MapPin,
    title: 'Lugares',
    description: 'Localizaciones emblemáticas, parajes naturales y lugares desaparecidos del término municipal.',
  },
  {
    href: 'fiestas',
    icon: PartyPopper,
    title: 'Fiestas',
    description: 'La fiesta patronal de la Virgen de la Peregrina y el resto del calendario festivo del pueblo.',
  },
  {
    href: 'escudo',
    icon: Shield,
    title: 'El Escudo',
    description: 'El significado de cada elemento del escudo heráldico oficial de Moriscos.',
  },
  {
    href: 'iglesia',
    icon: Church,
    title: 'La Iglesia',
    description: 'Historia, arquitectura y tesoros artísticos de la Iglesia de San Pedro Apóstol.',
  },
  {
    href: 'libro',
    icon: BookOpen,
    title: 'El Libro',
    description: 'Once capítulos que recorren la geografía, la toponimia, la economía y los sucesos de Moriscos.',
  },
  {
    href: 'ruta-nocturna',
    icon: Map,
    title: 'Ruta Nocturna',
    description: 'Mapa interactivo con los ocho hitos del camino de 7,7 km hasta el soto de La Flecha.',
  },
  {
    href: 'genealogia',
    icon: Users,
    title: 'Genealogía',
    description: 'El Bosque Genealógico y los paisanos ilustres del pueblo, con registros desde 1645.',
  },
  {
    href: 'glosario',
    icon: BookMarked,
    title: 'Glosario',
    description: 'El vocabulario tradicional del campo salmantino, clasificado por categorías.',
  },
  {
    href: 'referencias',
    icon: Library,
    title: 'Referencias',
    description: 'Fuentes documentales, archivos históricos, hemeroteca y estudios de los que proceden los datos.',
  },
  {
    href: 'sobre-la-web',
    icon: Info,
    title: 'Sobre la web',
    description: 'Por qué existe este proyecto, de dónde sale la información y el escudo del pueblo.',
  },
];
---

<BaseLayout
  title="Moriscos · Historia, Lugares y Curiosidades"
  description="Plataforma documental sobre la historia, geografía, etnografía y memoria viva de Moriscos (Salamanca) y el entorno de La Flecha."
>
  <section class="container-editorial py-14 sm:py-20">
    <p class="kicker">El pueblo</p>
    <h1 class="mt-2 text-balance font-serif text-4xl font-bold text-tinta dark:text-pergamino-muted sm:text-5xl">Moriscos, un pueblo de La Armuña</h1>
    <p class="mt-4 text-balance text-lg font-medium text-armuna-dark dark:text-piedra-200">
      Este es un archivo digital abierto para documentar y dar a conocer la historia, los orígenes, la evolución y las curiosidades de Moriscos, de forma que su memoria no dependa solo del recuerdo de sus vecinos.
    </p>
    <div class="mt-5 space-y-4 text-tinta/75 dark:text-pergamino-muted/75">
      <p>
        Moriscos es un pequeño municipio de la comarca de La Armuña, a unos 9 km al este-noreste de Salamanca capital, con poco más
        de 500 habitantes. Su término se extiende sobre la penillanura cerealista que da nombre a la comarca, entre los
        cursos del Tormes y del Zurguén, lindando con el paraje de La Flecha, retiro contemplativo de Fray Luis de León.
      </p>
      <p>
        Documentado desde 1164 como aldea del alfoz salmantino en plena repoblación medieval, Moriscos fue absorbiendo
        con los siglos los despoblados vecinos de El Hoyo y Ribas, vivió de cerca la Guerra de la Independencia de 1812
        y atravesó episodios de posguerra como el suceso de 1941. Su economía, tradicionalmente agraria &mdash;trigo,
        lenteja de La Armuña y el singular cultivo del zumaque&mdash;, ha ido dando paso en las últimas décadas a su
        integración en el área metropolitana de Salamanca.
      </p>
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href={`${base}libro`} class="btn-secondary">Descubre toda la historia en El Libro</a>
      <a
        href="https://github.com/pCresp0/moriscos-wiki"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contador de visitas de la web"
        class="inline-flex items-center gap-2 rounded-xl border border-noche-border bg-noche-surface/70 px-3.5 py-2.5 shadow-sm transition-all hover:border-piedra-400/40 hover:bg-noche-surface"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-piedra-400 animate-pulse"></span>
        <img
          src="https://visitor-badge.laobi.icu/badge?page_id=pcresp0.moriscos-wiki&left_text=visitas&left_color=2A241D&right_color=7A4D2B&radius=6&format=true"
          alt="Contador de visitas"
          width="90"
          height="20"
          loading="lazy"
          class="h-4 w-auto rounded opacity-85 transition-opacity hover:opacity-100"
        />
      </a>
    </div>
  </section>

  <CounterGrid />

  <section class="container-editorial py-16 sm:py-20">
    <p class="kicker">En esta web</p>
    <h2 class="mt-2 font-serif text-3xl font-bold text-tinta dark:text-pergamino-muted sm:text-4xl">Qué vas a encontrar</h2>
    <p class="mt-3 text-tinta/70 dark:text-pergamino-muted/70">
      Cada apartado documenta una parte distinta del pueblo: su historia y sus orígenes, sus lugares, su gente, sus
      tradiciones y sus curiosidades.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {sections.map(({ href, icon: Icon, title, description }) => (
        <a
          href={`${base}${href}`}
          data-astro-prefetch="load"
          class="group flex flex-col gap-3 rounded-2xl border border-piedra-border/60 bg-pergamino p-6 transition-all hover:-translate-y-1 hover:border-piedra-300 hover:shadow-lg dark:border-noche-border dark:bg-noche"
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-armuna/10 text-armuna dark:bg-piedra-300/10 dark:text-piedra-300">
            <Icon size={19} strokeWidth={2} />
          </span>
          <span class="font-serif text-lg font-semibold text-tinta dark:text-pergamino-muted">{title}</span>
          <span class="text-sm text-tinta/65 dark:text-pergamino-muted/65">{description}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

