---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteMap from '../components/RouteMap';
---

<BaseLayout
  title="Ruta Nocturna"
  description="Mapa interactivo de los 7,7 km entre Moriscos y el soto de La Flecha, con sus ocho hitos históricos y naturales."
>
  <section class="container-editorial py-14 sm:py-20">
    <p class="kicker">Guía de campo</p>
    <h1 class="mt-2 max-w-2xl text-balance font-serif text-4xl font-bold text-tinta dark:text-pergamino-muted sm:text-5xl">
      Ruta Nocturna: de Moriscos al soto de La Flecha
    </h1>
    <p class="mt-4 max-w-2xl text-tinta/70 dark:text-pergamino-muted/70">
      Un itinerario de 7,7 kilómetros que atraviesa el vértice geodésico "Andorra", los escenarios de la batalla de 1812 y el antiguo despoblado de Ribas, antes de llegar al oratorio donde se retiró Fray Luis de León.
    </p>

    <div class="mt-10">
      <RouteMap client:only="react" />
    </div>
  </section>
</BaseLayout>
