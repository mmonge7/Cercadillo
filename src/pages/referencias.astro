---
import BaseLayout from '../layouts/BaseLayout.astro';
import { referencesData, referenceCategories } from '../data/references';
import { ExternalLink, BookOpen, FileText, Calendar, Building2, MapPin } from 'lucide-react';

const categories = Object.entries(referenceCategories);
---

<BaseLayout
  title="Referencias y fuentes documentales"
  description="Fuentes históricas, archivos documentales, investigaciones etnográficas, hemeroteca y portales de los que proceden los datos de Moriscos Wiki."
>
  <section class="container-editorial py-14 sm:py-20">
    <p class="kicker">Fuentes &amp; Bibliografía</p>
    <h1 class="mt-2 text-balance font-serif text-4xl font-bold text-tinta dark:text-pergamino-muted sm:text-5xl">
      Referencias y fuentes documentales
    </h1>
    <p class="mt-4 text-balance text-base leading-relaxed text-tinta/80 dark:text-pergamino-muted/80 sm:text-lg">
      Aquí se incluyen las principales fuentes históricas, legajos de archivos eclesiásticos y estatales, monografías académicas, crónicas de prensa y portales digitales de los que se han extraído y contrastado los datos que se muestran en esta web.
    </p>

    <!-- Barra de filtros por categoría -->
    <div class="mt-10 flex flex-wrap items-center gap-2" id="filter-container">
      <button
        type="button"
        data-filter="all"
        class="ref-filter-btn active rounded-full border border-piedra-400/50 bg-piedra-400/20 px-4 py-2 text-xs sm:text-sm font-semibold text-piedra-200 shadow-sm transition-all hover:bg-piedra-400/30"
      >
        Todas ({referencesData.length})
      </button>
      {categories.map(([key, cat]) => {
        const count = referencesData.filter((r) => r.categoria === key).length;
        return (
          <button
            type="button"
            data-filter={key}
            class="ref-filter-btn rounded-full border border-noche-border bg-noche-surface/60 px-4 py-2 text-xs sm:text-sm font-semibold text-pergamino-muted/70 shadow-sm transition-all hover:border-piedra-400/40 hover:bg-noche-surface hover:text-pergamino-muted"
          >
            {cat.badge} ({count})
          </button>
        );
      })}
    </div>

    <!-- Lista de referencias -->
    <div class="mt-10 grid gap-6" id="references-grid">
      {referencesData.map((ref) => (
        <article
          id={ref.id}
          data-category={ref.categoria}
          class="reference-card scroll-mt-24 rounded-3xl border border-noche-border/90 bg-noche-surface/90 p-6 sm:p-8 shadow-lg transition-all hover:border-piedra-400/50 hover:shadow-black/40"
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-full border border-piedra-400/40 bg-piedra-400/15 px-3 py-1 font-display text-xs font-bold uppercase tracking-wider text-piedra-200">
                {referenceCategories[ref.categoria]?.badge ?? ref.categoria}
              </span>
              <span class="rounded-full border border-noche-border bg-noche px-3 py-1 font-body text-xs font-medium text-pergamino-muted/70">
                {ref.tipoFuente}
              </span>
            </div>
            <span class="inline-flex items-center gap-1.5 font-display text-xs sm:text-sm font-semibold text-piedra-300">
              <Calendar size={15} className="text-piedra-400" />
              {ref.anioRegistro}
            </span>
          </div>

          <h2 class="mt-4 font-serif text-xl sm:text-2xl font-bold leading-snug text-pergamino">
            {ref.titulo}
          </h2>

          <div class="mt-3 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs sm:text-sm text-pergamino-muted/75">
            <span class="inline-flex items-center gap-1.5 font-medium">
              <Building2 size={16} className="text-piedra-400 shrink-0" />
              {ref.autorInstitucion}
            </span>
            {ref.ubicacionArchivo && (
              <span class="inline-flex items-center gap-1.5 font-medium text-piedra-300">
                <MapPin size={16} className="text-piedra-400 shrink-0" />
                {ref.ubicacionArchivo}
              </span>
            )}
          </div>

          <!-- Aportaciones históricas -->
          <div class="mt-5 border-t border-noche-border/80 pt-4">
            <p class="font-display text-xs font-bold uppercase tracking-widest text-piedra-300">
              Aportación y datos extraídos:
            </p>
            <ul class="mt-3 space-y-2">
              {ref.aportacionHistorica.map((item) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-pergamino-muted/90">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-piedra-400" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          {ref.url && (
            <div class="mt-6 flex justify-end">
              <a
                href={ref.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl border border-piedra-400/40 bg-piedra-400/10 px-4 py-2 text-xs sm:text-sm font-semibold text-piedra-200 transition-all hover:border-piedra-300 hover:bg-piedra-400/25 hover:text-pergamino"
              >
                <span>Consultar fuente externa</span>
                <ExternalLink size={15} />
              </a>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.ref-filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.reference-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      filterBtns.forEach((b) => {
        const isActive = b === btn;
        b.classList.toggle('active', isActive);
        b.classList.toggle('border-piedra-400/50', isActive);
        b.classList.toggle('bg-piedra-400/20', isActive);
        b.classList.toggle('text-piedra-200', isActive);
        b.classList.toggle('border-noche-border', !isActive);
        b.classList.toggle('bg-noche-surface/60', !isActive);
        b.classList.toggle('text-pergamino-muted/70', !isActive);
      });

      cards.forEach((card) => {
        const category = card.getAttribute('data-category');
        const show = filter === 'all' || category === filter;
        card.style.display = show ? 'block' : 'none';
      });
    });
  });
</script>
