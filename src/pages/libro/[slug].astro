---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  return chapters.map((chapter) => ({
    params: { slug: chapter.id },
    props: { chapter, all: chapters.sort((a, b) => a.data.order - b.data.order) },
  }));
}

const { chapter, all } = Astro.props;
const { Content, headings } = await render(chapter);
const base = import.meta.env.BASE_URL;

const index = all.findIndex((c) => c.id === chapter.id);
const prev = index > 0 ? all[index - 1] : null;
const next = index < all.length - 1 ? all[index + 1] : null;
---

<BaseLayout title={`Cap. ${chapter.data.number} · ${chapter.data.title}`} description={chapter.data.dek}>
  <ReadingProgress />

  <article class="container-editorial py-14 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[220px,1fr]">
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
          <a href={`${base}libro`} class="mt-8 inline-flex items-center gap-1 text-sm font-medium text-armuna hover:underline dark:text-piedra-300">
            &larr; Todos los capítulos
          </a>
        </div>
      </aside>

      <div>
        <p class="kicker">Capítulo {chapter.data.number} · {chapter.data.readingMinutes} min de lectura</p>
        <h1 class="mt-2 text-balance font-serif text-3xl font-bold text-armuna-dark dark:text-piedra-100 sm:text-4xl">
          {chapter.data.title}
        </h1>
        <p class="mt-3 max-w-prose text-lg text-tinta/70 dark:text-pergamino-muted/70">{chapter.data.dek}</p>

        <div class="prose-armuna mt-10">
          <Content />
        </div>

        <nav class="mt-16 grid gap-4 border-t border-piedra-border/60 pt-8 dark:border-noche-border sm:grid-cols-2">
          {prev ? (
            <a href={`${base}libro/${prev.id}`} class="rounded-2xl border border-piedra-border/60 p-5 hover:border-piedra-300 dark:border-noche-border">
              <span class="text-xs font-semibold uppercase tracking-wide text-armuna dark:text-piedra-300">&larr; Anterior</span>
              <p class="mt-1 font-serif font-semibold text-tinta dark:text-pergamino-muted">{prev.data.title}</p>
            </a>
          ) : <span />}
          {next ? (
            <a href={`${base}libro/${next.id}`} class="rounded-2xl border border-piedra-border/60 p-5 text-right hover:border-piedra-300 dark:border-noche-border">
              <span class="text-xs font-semibold uppercase tracking-wide text-armuna dark:text-piedra-300">Siguiente &rarr;</span>
              <p class="mt-1 font-serif font-semibold text-tinta dark:text-pergamino-muted">{next.data.title}</p>
            </a>
          ) : <span />}
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>
