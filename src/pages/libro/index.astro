---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="El Libro Monográfico"
  description="Los 10 capítulos completos sobre la historia, geografía y memoria de Moriscos (Salamanca)."
>
  <section class="container-editorial py-16 sm:py-24">
    <p class="kicker">El libro monográfico</p>
    <h1 class="mt-2 max-w-2xl text-balance font-serif text-4xl font-bold text-tinta dark:text-pergamino-muted sm:text-5xl">
      Diez capítulos sobre Moriscos, La Armuña y La Flecha
    </h1>
    <p class="mt-4 max-w-2xl text-tinta/70 dark:text-pergamino-muted/70">
      Un recorrido completo desde el marco geográfico hasta el epílogo documental, pensado para leerse en orden o consultarse como referencia.
    </p>

    <ol class="mt-12 space-y-4">
      {chapters.map((c) => (
        <li>
          <a
            href={`${base}libro/${c.id}`}
            class="group flex flex-col gap-2 rounded-2xl border border-piedra-border/60 bg-pergamino p-6 transition-all hover:border-piedra-300 hover:shadow-lg dark:border-noche-border dark:bg-noche-surface sm:flex-row sm:items-center sm:gap-6"
          >
            <span class="font-display text-3xl font-bold text-piedra-300 dark:text-piedra-500 sm:w-16 sm:shrink-0">
              {String(c.data.number).padStart(2, '0')}
            </span>
            <div class="flex-1">
              <h2 class="font-serif text-xl font-semibold text-tinta dark:text-pergamino-muted">{c.data.title}</h2>
              <p class="mt-1 text-sm text-tinta/65 dark:text-pergamino-muted/65">{c.data.dek}</p>
            </div>
            <span class="shrink-0 text-xs font-medium uppercase tracking-wide text-armuna dark:text-piedra-300">
              {c.data.readingMinutes} min de lectura
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
