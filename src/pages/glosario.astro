---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlossaryCard from '../components/GlossaryCard.astro';
import { getCollection } from 'astro:content';

const terms = (await getCollection('glosario')).sort((a, b) => a.data.term.localeCompare(b.data.term));
const categories = ['Todos', ...Array.from(new Set(terms.map((t) => t.data.category)))];
---

<BaseLayout
  title="Glosario Etnográfico"
  description="Palabras tradicionales armuñesas: maquila, zumacales, cavenes, costal, media fanega y más."
>
  <section class="container-editorial py-14 sm:py-20">
    <p class="kicker">Memoria de la lengua</p>
    <h1 class="mt-2 max-w-2xl text-balance font-serif text-4xl font-bold text-tinta dark:text-pergamino-muted sm:text-5xl">
      Glosario etnográfico armuñés
    </h1>
    <p class="mt-4 max-w-2xl text-tinta/70 dark:text-pergamino-muted/70">
      El vocabulario tradicional del campo salmantino, clasificado por categorías: aperos, naturaleza, medidas y topónimos.
    </p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filtrar glosario por categoría">
      {categories.map((cat, i) => (
        <button
          type="button"
          data-filter={cat}
          class:list={[
            'rounded-full border px-4 py-2 text-sm font-medium transition-colors',
            i === 0
              ? 'border-soto bg-soto text-pergamino'
              : 'border-piedra-border/60 text-tinta/70 hover:border-piedra-300 dark:border-noche-border dark:text-pergamino-muted/70',
          ]}
        >
          {cat}
        </button>
      ))}
    </div>

    <div id="glossary-grid" class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {terms.map((t) => <GlossaryCard id={t.id} term={t.data.term} category={t.data.category} short={t.data.short} />)}
    </div>
  </section>

  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#glossary-grid [data-category]'));

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('bg-soto', active);
          b.classList.toggle('text-pergamino', active);
          b.classList.toggle('border-soto', active);
          b.classList.toggle('border-piedra-border/60', !active);
        });
        cards.forEach((card) => {
          const show = filter === 'Todos' || card.dataset.category === filter;
          card.style.display = show ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
