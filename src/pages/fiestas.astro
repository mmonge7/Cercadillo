---
import BaseLayout from '../layouts/BaseLayout.astro';

const otrasFiestas = [
  {
    title: 'San Pedro Apóstol',
    date: '29 de junio',
    tag: 'Patrón del pueblo',
    description:
      'Patrón titular de la parroquia y del municipio. Aunque los festejos multitudinarios de verano se centran en la Virgen Peregrina, este día se celebran los actos litúrgicos e institucionales en su honor.',
  },
  {
    title: 'San Isidro Labrador',
    date: '15 de mayo',
    tag: 'Fiesta agrícola',
    description:
      'Homenaje de los agricultores a San Isidro con la bendición de los campos de cultivo y una jornada de convivencia, en un municipio históricamente volcado en el secano de La Armuña (trigo, cebada y la I.G.P. Lenteja de La Armuña).',
  },
  {
    title: 'El Lunes de Agua',
    date: 'Lunes siguiente al Lunes de Pascua',
    tag: 'Tradición salmantina',
    description:
      'Como en toda la provincia, los vecinos acuden al campo en familia o en cuadrillas a merendar el hornazo salmantino, tradicionalmente en la confluencia de los arroyos locales o en los sotos del Tormes, en la finca de La Flecha.',
  },
];

const eventos = [
  {
    title: 'Ruta Nocturna a La Flecha',
    description:
      'Promovida por la Asociación Cultural de Mujeres de Moriscos, esta caminata de 7,7 km se celebra en noches estivales de luna llena, recorriendo el Camino de la Aceña hacia el Tormes y recitando versos de Fray Luis de León y Unamuno.',
  },
  {
    title: 'Tiradas al plato',
    description:
      'Organizadas históricamente durante las fiestas en los terrenos sobrantes de la concentración parcelaria, entre el Camino de la Aceña y Valdepega.',
  },
  {
    title: 'MotoCross de Moriscos',
    description:
      'Evento deportivo de motor celebrado durante años en agosto, aprovechando las crestas y socavones del paraje de Las Cavenes.',
  },
  {
    title: 'Archivo histórico',
    description:
      'La memoria gráfica del pueblo conserva álbumes y vídeos de las fiestas registrados ininterrumpidamente desde 1995.',
  },
];
---

<BaseLayout
  title="Fiestas y Tradiciones"
  description="Las fiestas patronales de la Virgen de la Peregrina, San Pedro Apóstol, San Isidro Labrador, el Lunes de Agua y los eventos culturales de Moriscos."
>
  <section class="container-editorial py-14 sm:py-20">
    <p class="kicker">Vida festiva</p>
    <h1 class="mt-2 text-balance font-serif text-4xl font-bold text-tinta dark:text-pergamino-muted sm:text-5xl">
      Fiestas y tradiciones de Moriscos
    </h1>
    <p class="mt-4 text-balance text-lg text-tinta/70 dark:text-pergamino-muted/70">
      Las fiestas y celebraciones de Moriscos conjugan la devoción religiosa, las tradiciones agrícolas de la comarca
      de La Armuña y una intensa vida comunitaria.
    </p>

    <div
      id="fiestas-countdown"
      class="mt-8 rounded-2xl border border-piedra-border/60 bg-pergamino-muted p-6 dark:border-noche-border dark:bg-noche-surface"
    >
      <p class="kicker">Cuenta atrás</p>
      <p id="fiestas-countdown-label" class="mt-2 font-serif text-lg font-semibold text-tinta dark:text-pergamino-muted">
        Calculando la próxima Fiesta Mayor…
      </p>
      <div class="mt-4 grid grid-cols-4 gap-3 text-center" aria-hidden="true">
        <div>
          <span id="cd-days" class="block font-display text-3xl font-bold text-armuna dark:text-piedra-300">–</span>
          <span class="text-xs text-tinta/60 dark:text-pergamino-muted/60">días</span>
        </div>
        <div>
          <span id="cd-hours" class="block font-display text-3xl font-bold text-armuna dark:text-piedra-300">–</span>
          <span class="text-xs text-tinta/60 dark:text-pergamino-muted/60">horas</span>
        </div>
        <div>
          <span id="cd-mins" class="block font-display text-3xl font-bold text-armuna dark:text-piedra-300">–</span>
          <span class="text-xs text-tinta/60 dark:text-pergamino-muted/60">min</span>
        </div>
        <div>
          <span id="cd-secs" class="block font-display text-3xl font-bold text-armuna dark:text-piedra-300">–</span>
          <span class="text-xs text-tinta/60 dark:text-pergamino-muted/60">seg</span>
        </div>
      </div>
      <p id="fiestas-countdown-dates" class="mt-4 text-sm text-tinta/70 dark:text-pergamino-muted/70"></p>
    </div>

    <div class="mt-12">
      <p class="kicker">Fiesta mayor</p>
      <h2 class="mt-2 font-serif text-2xl font-semibold text-armuna-dark dark:text-piedra-200">
        Fiestas Patronales en honor a la Virgen de la Peregrina
      </h2>
      <p class="mt-3 leading-relaxed text-tinta/75 dark:text-pergamino-muted/75">
        Es la fiesta principal del municipio. La patrona de Moriscos es la <strong>Virgen de la Peregrina</strong>,
        cuya imagen &mdash;un valioso lienzo barroco restaurado en 2016&mdash; se custodia en la Iglesia de San Pedro
        Apóstol.
      </p>

      <div class="prose-armuna mt-6">
        <h3>Cambio histórico de fechas</h3>
        <p>
          Antiguamente, la festividad se celebraba el <strong>Domingo de Pentecostés</strong>. Hacia 1988, como
          ocurrió en muchos pueblos castellanos, la celebración se trasladó a los meses de verano para facilitar la
          asistencia de los vecinos que residen fuera durante sus vacaciones y de los estudiantes tras los exámenes.
          Actualmente se celebra entre la <strong>última semana de julio y el primer fin de semana de agosto</strong>
          (habitualmente del jueves 30 de julio al domingo 2 de agosto).
        </p>

        <h3>Semana cultural previa</h3>
        <p>
          Durante los diez días anteriores al estallido de las fiestas (a partir del 21 de julio aproximadamente), el
          Ayuntamiento y las asociaciones locales organizan una semana cultural con cine de verano al aire libre,
          certámenes de teatro de calle, exposiciones y recitales de música tradicional castellana.
        </p>

        <h3>Programa de festejos</h3>
        <p><strong>Jueves (inicio de fiestas):</strong> maquillaje infantil en el Parque Grande; a las 21:30 h, chupinazo
          inicial y repique manual de campanas desde la torre de la iglesia; chocolatada con churros colectiva;
          espectáculos nocturnos de flamenco y rumbas en la Plaza Grande.</p>
        <p><strong>Viernes:</strong> casetas de feria y juegos para niños en la Plaza Grande; gala fin de curso de danza
          de la agrupación local "Más Que Danza Moriscos"; noche de baile con macrodiscoteca.</p>
        <p><strong>Sábado:</strong> animación matutina y vermú con charangas en el Parque Chico; paella popular
          comunitaria cuya recaudación se dona a entidades sociales como la Asociación Autismo ARIADNA; encierro
          infantil de carretones simulados conocido como "Asaltacalles" en la Plaza Chica; el tradicional partido de
          fútbol sala "Solteros vs. Casados" en el polideportivo comarcal; gran verbena nocturna con orquesta y
          discomóvil hasta la madrugada.</p>
        <p><strong>Domingo (día grande y misa solemne):</strong> pasacalles matutino de tamborileros y dulzaineros con
          repique de campanas; a las 13:00 h, Santa Misa Solemne en honor a la Virgen Peregrina; procesión de la
          Virgen por las calles del casco urbano, llevada a hombros por los vecinos y flanqueada por música
          procesional; subasta de las roscas de pan bendito; tarde infantil con juegos acuáticos, tren neumático y
          fiesta de la espuma; cierre a las 21:00 h con una parrillada popular de convivencia vecinal, también de
          carácter benéfico.</p>

        <h3>Ritos y costumbres exclusivas</h3>
        <p>
          La memoria local recogida por el portal Morisqueños destaca la pervivencia de costumbres propias como la
          <strong>"Acogótala"</strong> &mdash;un ritual festivo de convivencia entre las peñas del pueblo&mdash; y
          <strong>"la pedida de la botella"</strong>, en la que mozos y peñas recorren las casas o bodegas del
          municipio pidiendo refrescos o vino para la fiesta.
        </p>
      </div>
    </div>

    <div class="mt-16">
      <p class="kicker">Calendario festivo</p>
      <h2 class="mt-2 font-serif text-2xl font-semibold text-armuna-dark dark:text-piedra-200">Otras fiestas del año</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {otrasFiestas.map((f) => (
          <article class="rounded-2xl border border-piedra-border/60 bg-pergamino p-6 dark:border-noche-border dark:bg-noche">
            <span class="font-display text-xs tracking-widest text-armuna dark:text-piedra-300">{f.tag.toUpperCase()}</span>
            <h3 class="mt-2 font-serif text-lg font-semibold text-tinta dark:text-pergamino-muted">{f.title}</h3>
            <p class="mt-1 text-sm font-semibold text-soto dark:text-piedra-300">{f.date}</p>
            <p class="mt-3 text-sm leading-relaxed text-tinta/70 dark:text-pergamino-muted/70">{f.description}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="mt-16">
      <p class="kicker">Más allá de las fiestas</p>
      <h2 class="mt-2 font-serif text-2xl font-semibold text-armuna-dark dark:text-piedra-200">Eventos culturales y deportivos</h2>
      <div class="mt-6 space-y-5">
        {eventos.map((e) => (
          <article class="border-l-2 border-piedra-300 pl-5 dark:border-piedra-500">
            <h3 class="font-serif text-base font-semibold text-tinta dark:text-pergamino-muted">{e.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-tinta/70 dark:text-pergamino-muted/70">{e.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    // Las Fiestas Patronales empiezan el jueves anterior al primer domingo de
    // agosto (el "domingo grande") y terminan ese mismo domingo. Se recalcula
    // en el navegador para que valga automáticamente para cualquier año.
    function firstSundayOfAugust(year: number): Date {
      const d = new Date(year, 7, 1); // 1 de agosto
      const offset = d.getDay() === 0 ? 0 : 7 - d.getDay();
      d.setDate(d.getDate() + offset);
      return d;
    }

    function festivalRange(year: number) {
      const sunday = firstSundayOfAugust(year);
      const start = new Date(sunday);
      start.setDate(sunday.getDate() - 3); // jueves
      start.setHours(21, 30, 0, 0); // hora del chupinazo
      const end = new Date(sunday);
      end.setHours(23, 59, 59, 999);
      return { start, end };
    }

    function nextFestival(now: Date) {
      let year = now.getFullYear();
      let { start, end } = festivalRange(year);
      if (now > end) {
        year += 1;
        ({ start, end } = festivalRange(year));
      }
      return { start, end, year };
    }

    function initCountdown() {
      const label = document.getElementById('fiestas-countdown-label');
      const datesEl = document.getElementById('fiestas-countdown-dates');
      const daysEl = document.getElementById('cd-days');
      const hoursEl = document.getElementById('cd-hours');
      const minsEl = document.getElementById('cd-mins');
      const secsEl = document.getElementById('cd-secs');
      if (!label) return;

      const dateFmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long' });
      const dateFmtWithYear = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

      function render() {
        const now = new Date();
        const { start, end, year } = nextFestival(now);
        const rangeText = `${dateFmt.format(start)} – ${dateFmtWithYear.format(end)}`;

        if (now >= start && now <= end) {
          if (label) label.textContent = `¡Las fiestas de ${year} están en marcha!`;
          if (datesEl) datesEl.textContent = `Hasta el ${dateFmtWithYear.format(end)}.`;
          if (daysEl) daysEl.textContent = '🎉';
          if (hoursEl) hoursEl.textContent = '';
          if (minsEl) minsEl.textContent = '';
          if (secsEl) secsEl.textContent = '';
          return;
        }

        const diff = start.getTime() - now.getTime();
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const mins = Math.floor((diff / (1000 * 60)) % 60);
        const secs = Math.floor((diff / 1000) % 60);

        if (label) label.textContent = `Faltan para la Fiesta Mayor de ${year}`;
        if (datesEl) datesEl.textContent = `Del ${rangeText}.`;
        if (daysEl) daysEl.textContent = String(days);
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minsEl) minsEl.textContent = String(mins).padStart(2, '0');
        if (secsEl) secsEl.textContent = String(secs).padStart(2, '0');
      }

      render();
      setInterval(render, 1000);
    }

    document.addEventListener('DOMContentLoaded', initCountdown);
    document.addEventListener('astro:page-load', initCountdown);
  </script>
</BaseLayout>
