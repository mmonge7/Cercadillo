---
export interface Props {
  id: string;
  term: string;
  category: string;
  short: string;
}
const { id, term, category, short } = Astro.props;

const categoryColor: Record<string, string> = {
  Aperos: 'bg-armuna/10 text-armuna-dark dark:bg-armuna/20 dark:text-armuna-light',
  Naturaleza: 'bg-soto/10 text-soto dark:bg-soto/20 dark:text-soto-light',
  Medidas: 'bg-piedra-200/60 text-piedra-700 dark:bg-piedra-500/20 dark:text-piedra-200',
  'Topónimos': 'bg-tinta/10 text-tinta dark:bg-pergamino-muted/10 dark:text-pergamino-muted',
  Oficios: 'bg-armuna/10 text-armuna-dark dark:bg-armuna/20 dark:text-armuna-light',
};
---

<article
  id={id}
  data-category={category}
  class="scroll-mt-24 rounded-2xl border border-piedra-border/60 bg-pergamino p-6 dark:border-noche-border dark:bg-noche-surface"
>
  <span class:list={['inline-block rounded-full px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide', categoryColor[category]]}>
    {category}
  </span>
  <h3 class="mt-3 font-serif text-xl font-semibold italic text-armuna-dark dark:text-piedra-200">{term}</h3>
  <p class="mt-2 text-sm leading-relaxed text-tinta/70 dark:text-pergamino-muted/70">{short}</p>
</article>
