---
const base = import.meta.env.BASE_URL;
---

<section class="relative overflow-hidden border-b border-piedra-border/60 dark:border-noche-border">
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-piedra-50 via-pergamino to-pergamino dark:from-noche-surface dark:via-noche dark:to-noche"></div>
  <div class="absolute -right-24 -top-24 -z-10 h-96 w-96 rounded-full bg-piedra-200/40 blur-3xl dark:bg-piedra-500/10"></div>
  <div class="absolute -left-24 bottom-0 -z-10 h-72 w-72 rounded-full bg-soto/10 blur-3xl"></div>

  <div class="container-editorial grid gap-10 py-16 sm:py-24 lg:grid-cols-[1.2fr,0.8fr] lg:items-center lg:py-28">
    <div class="animate-fade-up">
      <p class="kicker mb-5">La Armuña · Salamanca</p>
      <h1 class="text-balance font-serif text-4xl font-bold leading-[1.08] text-armuna-dark dark:text-piedra-100 sm:text-5xl lg:text-6xl">
        Moriscos: memoria, historia y territorio de un pueblo de La Armuña
      </h1>
      <p class="mt-6 max-w-xl text-balance font-body text-lg leading-relaxed text-tinta/75 dark:text-pergamino-muted/75">
        Un archivo vivo de la geografía, la etnografía y la memoria oral de Moriscos: desde la repoblación medieval de 1164 hasta el soto contemplativo de La Flecha, a 7,7 km de distancia.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href={`${base}libro`} class="btn-primary">
          Explorar el Archivo
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href={`${base}ruta-nocturna`} class="btn-secondary">
          Comenzar la Ruta Nocturna
        </a>
      </div>
    </div>

    <div class="relative animate-fade-up [animation-delay:150ms]">
      <div class="aspect-[4/5] w-full max-w-sm justify-self-center overflow-hidden rounded-[2rem] border border-piedra-border/70 shadow-2xl dark:border-noche-border sm:justify-self-end">
        <svg viewBox="0 0 400 500" class="h-full w-full" preserveAspectRatio="xMidYMax slice" role="img" aria-label="Ilustración de la iglesia de San Pedro de Moriscos al atardecer">
          <defs>
            <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#8C4A32"/>
              <stop offset="55%" stop-color="#B88432"/>
              <stop offset="100%" stop-color="#D4A359"/>
            </linearGradient>
            <linearGradient id="ground" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1E3F2E"/>
              <stop offset="100%" stop-color="#14171A"/>
            </linearGradient>
          </defs>
          <rect width="400" height="500" fill="url(#sky)"/>
          <circle cx="300" cy="120" r="46" fill="#FDFBF7" opacity="0.16"/>
          <circle cx="300" cy="120" r="30" fill="#FDFBF7" opacity="0.25"/>

          <path d="M0 300 Q100 270 200 300 T400 300 V500 H0 Z" fill="#734F1E" opacity="0.55"/>

          <!-- church silhouette -->
          <g fill="#14171A">
            <rect x="150" y="150" width="55" height="190" />
            <polygon points="150,150 177.5,110 205,150" />
            <rect x="170" y="180" width="15" height="24" fill="#D4A359" opacity="0.7" />
            <rect x="172" y="260" width="11" height="22" fill="#B88432" opacity="0.8" />
            <rect x="115" y="270" width="170" height="70" />
            <polygon points="110,270 200,225 290,270" />
            <rect x="60" y="300" width="55" height="40" />
            <rect x="285" y="300" width="55" height="40" />
            <rect x="0" y="330" width="400" height="170" />
          </g>
          <rect x="172" y="118" width="11" height="20" fill="#14171A"/>
          <path d="M177.5 108 v-14 M171 98 h13" stroke="#14171A" stroke-width="4" stroke-linecap="round"/>

          <path d="M0 500 V420 Q60 400 120 420 T240 420 T400 415 V500Z" fill="url(#ground)"/>
          <g stroke="#D4A359" stroke-width="2" opacity="0.6" stroke-linecap="round">
            <path d="M40 470 v-30 M40 440 l-6 -10 M40 440 l6 -10"/>
            <path d="M70 480 v-30 M70 450 l-6 -10 M70 450 l6 -10"/>
            <path d="M340 475 v-30 M340 445 l-6 -10 M340 445 l6 -10"/>
            <path d="M370 465 v-30 M370 435 l-6 -10 M370 435 l6 -10"/>
          </g>
        </svg>
      </div>
      <div class="mt-4 flex items-center justify-center gap-2 text-center sm:justify-end">
        <span class="h-px w-8 bg-piedra-300"></span>
        <p class="font-serif text-sm italic text-tinta/60 dark:text-pergamino-muted/60">"Piedra de Villamayor, memoria de siglos."</p>
      </div>
    </div>
  </div>
</section>
