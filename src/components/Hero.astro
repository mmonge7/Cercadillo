---
const base = import.meta.env.BASE_URL;
---

<section class="relative overflow-hidden border-b border-piedra-border/60 dark:border-noche-border">
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-piedra-50 via-pergamino to-pergamino dark:from-noche-surface dark:via-noche dark:to-noche"></div>
  <div class="absolute -right-24 -top-24 -z-10 h-96 w-96 rounded-full bg-piedra-200/40 blur-3xl dark:bg-piedra-500/10"></div>
  <div class="absolute -left-24 bottom-0 -z-10 h-72 w-72 rounded-full bg-soto/10 blur-3xl"></div>

  <div class="container-editorial grid gap-10 py-16 sm:py-24 lg:grid-cols-[1.2fr,0.8fr] lg:items-center lg:py-28">
    <div class="animate-fade-up">
      <p class="kicker mb-5">La Armuña · Salamanca</p>
      <h1 class="text-balance font-serif text-4xl font-bold leading-[1.08] text-armuna-dark dark:text-piedra-100 sm:text-5xl lg:text-6xl">
        Moriscos: memoria, historia y territorio de un pueblo de La Armuña
      </h1>
      <p class="mt-6 max-w-xl text-balance font-body text-lg leading-relaxed text-tinta/75 dark:text-pergamino-muted/75">
        Un archivo vivo de la geografía, la etnografía y la memoria oral de Moriscos: desde la repoblación medieval de 1164 hasta el soto contemplativo de La Flecha, a 7,7 km de distancia.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href={`${base}libro`} class="btn-primary">
          Explorar el Archivo
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href={`${base}ruta-nocturna`} class="btn-secondary">
          Comenzar la Ruta Nocturna
        </a>
      </div>
    </div>

    <div class="relative animate-fade-up [animation-delay:150ms]">
      <div class="aspect-[4/5] w-full max-w-sm justify-self-center overflow-hidden rounded-[2rem] border border-piedra-border/70 bg-gradient-to-br from-armuna-dark via-armuna to-piedra-400 shadow-2xl dark:border-noche-border sm:justify-self-end">
        <div class="flex h-full flex-col items-center justify-center gap-6 p-8 text-center text-pergamino">
          <svg viewBox="0 0 24 24" class="h-16 w-16 opacity-90" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 3 3 8v3c0 6 4 8.5 9 10 5-1.5 9-4 9-10V8z"/><path d="M9 12.5l2 2 4-4.5"/></svg>
          <p class="font-display text-sm tracking-[0.3em]">IGLESIA DE SAN PEDRO</p>
          <p class="font-serif text-lg italic leading-snug opacity-90">"Piedra de Villamayor, memoria de siglos."</p>
        </div>
      </div>
    </div>
  </div>
</section>
