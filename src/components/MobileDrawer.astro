---
import { Home, BookOpen, Map, Users, BookMarked, Info, PartyPopper, Church, Shield, MapPin, History, Library, X } from 'lucide-react';
import { navLinks } from '../data/site';
import { isActiveHref } from '../utils/nav';

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const icons: Record<string, typeof Home> = {
  '/': Home,
  '/historia': History,
  '/lugares': MapPin,
  '/fiestas': PartyPopper,
  '/escudo': Shield,
  '/iglesia': Church,
  '/libro': BookOpen,
  '/ruta-nocturna': Map,
  '/genealogia': Users,
  '/glosario': BookMarked,
  '/referencias': Library,
  '/sobre-la-web': Info,
};
---

<div id="mobile-drawer" class="fixed inset-0 z-[9999] pointer-events-none lg:hidden" role="dialog" aria-modal="true" aria-label="Menú de navegación">
  <div
    id="drawer-backdrop"
    class="absolute inset-0 bg-noche/60 opacity-0 backdrop-blur-sm transition-opacity duration-300 ease-out"
  >
  </div>
  <div
    id="drawer-panel"
    class="brand-panel absolute inset-y-0 left-0 flex w-72 max-w-[80vw] -translate-x-full flex-col shadow-2xl transition-transform duration-300 ease-out"
  >
    <div class="flex items-center justify-between px-5 pb-4 pt-[calc(env(safe-area-inset-top,0px)+1.25rem)]">
      <div class="flex items-center gap-2.5 font-display text-xl font-bold tracking-wider text-pergamino">
        <img src={`${base}images/escudo-moriscos-160.jpg`} alt="Escudo de Moriscos" class="h-8 w-8 rounded-full object-cover ring-2 ring-piedra-300/80 shadow-sm" width="32" height="32" />
        MORISCOS
      </div>
      <button id="drawer-close" type="button" aria-label="Cerrar menú" class="inline-flex h-9 w-9 items-center justify-center rounded-full hover:bg-pergamino/10">
        <X size={20} strokeWidth={1.8} />
      </button>
    </div>
    <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-2" aria-label="Navegación principal (móvil)">
      {navLinks.map((link) => {
        const Icon = icons[link.href] ?? Home;
        const active = isActiveHref(path, base, link.href);
        return (
          <a
            href={base + link.href.replace(/^\//, '')}
            class="nav-item text-base"
            data-active={String(active)}
            data-astro-prefetch="load"
          >
            <Icon size={19} strokeWidth={active ? 2.4 : 2} />
            <span>{link.label}</span>
          </a>
        );
      })}
    </nav>
  </div>
</div>

<script>
  let isNavigatingFromDrawer = false;

  function initMobileDrawer() {
    const openBtn = document.getElementById('drawer-open');
    const closeBtn = document.getElementById('drawer-close');
    const backdrop = document.getElementById('drawer-backdrop');
    const drawer = document.getElementById('mobile-drawer');
    const panel = document.getElementById('drawer-panel');

    const setOpen = (open: boolean) => {
      if (!drawer || !panel || !backdrop) return;
      drawer.classList.toggle('pointer-events-none', !open);
      panel.classList.toggle('-translate-x-full', !open);
      backdrop.classList.toggle('opacity-0', !open);
      openBtn?.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };

    openBtn?.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', () => setOpen(false));
    backdrop?.addEventListener('click', () => setOpen(false));

    // Al pulsar un enlace del menú móvil, indicamos que la navegación
    // se produce desde el drawer para mantenerlo montado hasta el cambio de vista
    drawer?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        isNavigatingFromDrawer = true;
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

  // 1. Antes del swap del DOM: mantenemos el drawer visible en el nuevo documento
  // y reseteamos el scroll arriba del todo
  document.addEventListener('astro:before-swap', (e: any) => {
    if (isNavigatingFromDrawer && e.newDocument) {
      const newDrawer = e.newDocument.getElementById('mobile-drawer');
      const newPanel = e.newDocument.getElementById('drawer-panel');
      const newBackdrop = e.newDocument.getElementById('drawer-backdrop');
      if (newDrawer && newPanel && newBackdrop) {
        newDrawer.classList.remove('pointer-events-none');
        newPanel.classList.remove('-translate-x-full');
        newBackdrop.classList.remove('opacity-0');
      }
    }
  });

  // 2. Justo tras insertar el nuevo DOM: el nuevo apartado ya está listo en el fondo.
  // Ahora el drawer se desliza suavemente hacia fuera, revelando la nueva sección.
  document.addEventListener('astro:after-swap', () => {
    if (isNavigatingFromDrawer) {
      isNavigatingFromDrawer = false;
      window.scrollTo({ top: 0, behavior: 'instant' });
      requestAnimationFrame(() => {
        const drawer = document.getElementById('mobile-drawer');
        const panel = document.getElementById('drawer-panel');
        const backdrop = document.getElementById('drawer-backdrop');
        const openBtn = document.getElementById('drawer-open');
        if (drawer && panel && backdrop) {
          drawer.classList.add('pointer-events-none');
          panel.classList.add('-translate-x-full');
          backdrop.classList.add('opacity-0');
          openBtn?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }
      });
    }
  });

  document.addEventListener('DOMContentLoaded', initMobileDrawer);
  document.addEventListener('astro:page-load', initMobileDrawer);

  const EDGE_EXCLUSION_PX = 30;
  const SWIPE_THRESHOLD_PX = 40;
  const isMobileViewport = () => !window.matchMedia('(min-width: 1024px)').matches;

  let touchStartX = 0;
  let touchStartY = 0;
  let touchStartOnMap = false;

  document.addEventListener(
    'touchstart',
    (e) => {
      const t = e.touches[0];
      touchStartX = t.clientX;
      touchStartY = t.clientY;
      touchStartOnMap = !!(e.target as HTMLElement)?.closest?.('.leaflet-container');
    },
    { passive: true },
  );

  document.addEventListener(
    'touchend',
    (e) => {
      if (!isMobileViewport() || touchStartOnMap) return;
      const t = e.changedTouches[0];
      const deltaX = t.clientX - touchStartX;
      const deltaY = t.clientY - touchStartY;
      if (Math.abs(deltaX) < SWIPE_THRESHOLD_PX || Math.abs(deltaX) <= Math.abs(deltaY)) return;
      const drawer = document.getElementById('mobile-drawer');
      const panel = document.getElementById('drawer-panel');
      const backdrop = document.getElementById('drawer-backdrop');
      const openBtn = document.getElementById('drawer-open');
      if (!drawer || !panel || !backdrop) return;
      if (deltaX > 0) {
        if (touchStartX > EDGE_EXCLUSION_PX) {
          drawer.classList.remove('pointer-events-none');
          panel.classList.remove('-translate-x-full');
          backdrop.classList.remove('opacity-0');
          openBtn?.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }
      } else {
        drawer.classList.add('pointer-events-none');
        panel.classList.add('-translate-x-full');
        backdrop.classList.add('opacity-0');
        openBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    },
    { passive: true },
  );
</script>
