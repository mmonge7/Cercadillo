---
import { Home, BookOpen, Map, Users, BookMarked, Info, X } from 'lucide-react';
import { navLinks } from '../data/site';
import { isActiveHref } from '../utils/nav';

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const icons: Record<string, typeof Home> = {
  '/': Home,
  '/libro': BookOpen,
  '/ruta-nocturna': Map,
  '/genealogia': Users,
  '/glosario': BookMarked,
  '/sobre-la-web': Info,
};
---

<div id="mobile-drawer" class="fixed inset-0 z-50 hidden lg:hidden" role="dialog" aria-modal="true" aria-label="Menú de navegación">
  <div id="drawer-backdrop" class="absolute inset-0 bg-noche/60 backdrop-blur-sm"></div>
  <div class="brand-panel absolute inset-y-0 left-0 flex w-72 max-w-[80vw] flex-col shadow-2xl">
    <div class="flex items-center justify-between px-5 pb-4 pt-[calc(env(safe-area-inset-top,0px)+1.25rem)]">
      <span class="font-display text-sm tracking-widest">MENÚ</span>
      <button id="drawer-close" type="button" aria-label="Cerrar menú" class="inline-flex h-9 w-9 items-center justify-center rounded-full hover:bg-pergamino/10">
        <X size={19} strokeWidth={1.8} />
      </button>
    </div>
    <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-2" aria-label="Navegación principal (móvil)">
      {navLinks.map((link) => {
        const Icon = icons[link.href] ?? Home;
        const active = isActiveHref(path, base, link.href);
        return (
          <a href={base + link.href.replace(/^\//, '')} class="nav-item text-base" data-active={String(active)}>
            <Icon size={19} strokeWidth={active ? 2.4 : 2} />
            <span>{link.label}</span>
          </a>
        );
      })}
    </nav>
    <p class="px-5 pb-[calc(env(safe-area-inset-bottom,0px)+1.25rem)] text-[0.65rem] text-pergamino/50">La Armuña · Salamanca</p>
  </div>
</div>

<script>
  const openBtn = document.getElementById('drawer-open');
  const closeBtn = document.getElementById('drawer-close');
  const backdrop = document.getElementById('drawer-backdrop');
  const drawer = document.getElementById('mobile-drawer');

  const setOpen = (open: boolean) => {
    if (!drawer) return;
    drawer.classList.toggle('hidden', !open);
    openBtn?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };

  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  backdrop?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
