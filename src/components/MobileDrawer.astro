---
import { Home, BookOpen, Map, Users, BookMarked, Info, PartyPopper, Church, Shield, MapPin, History, Library, X } from 'lucide-react';
import { navLinks } from '../data/site';
import { isActiveHref } from '../utils/nav';

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const icons: Record<string, typeof Home> = {
  '/': Home,
  '/historia': History,
  '/lugares': MapPin,
  '/fiestas': PartyPopper,
  '/escudo': Shield,
  '/iglesia': Church,
  '/libro': BookOpen,
  '/ruta-nocturna': Map,
  '/genealogia': Users,
  '/glosario': BookMarked,
  '/referencias': Library,
  '/sobre-la-web': Info,
};
---

<div
  id="mobile-drawer"
  transition:persist="mobile-drawer"
  class="fixed inset-0 z-[9999] pointer-events-none lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <div
    id="drawer-backdrop"
    class="absolute inset-0 bg-black/50 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 [transition-timing-function:cubic-bezier(0.4,0,0.2,1)]"
  >
  </div>
  <div
    id="drawer-panel"
    class="brand-panel absolute inset-y-0 left-0 flex w-[256px] max-w-[82vw] -translate-x-full flex-col shadow-[6px_0_32px_rgba(0,0,0,0.4)] transition-transform duration-300 [transition-timing-function:cubic-bezier(0.4,0,0.2,1)]"
  >
    <div class="flex items-center justify-between px-5 pb-4 pt-[calc(env(safe-area-inset-top,0px)+1.25rem)]">
      <div class="flex items-center gap-2.5 font-display text-xl font-bold tracking-wider text-pergamino">
        <img src={`${base}images/escudo-moriscos-160.jpg`} alt="Escudo de Moriscos" class="h-8 w-8 rounded-full object-cover ring-2 ring-piedra-300/80 shadow-sm" width="32" height="32" />
        MORISCOS
      </div>
      <button id="drawer-close" type="button" aria-label="Cerrar menú" class="inline-flex h-9 w-9 items-center justify-center rounded-full hover:bg-pergamino/10">
        <X size={20} strokeWidth={1.8} />
      </button>
    </div>
    <nav id="mobile-nav-list" class="flex-1 space-y-1 overflow-y-auto px-3 py-2" aria-label="Navegación principal (móvil)">
      {navLinks.map((link) => {
        const Icon = icons[link.href] ?? Home;
        const active = isActiveHref(path, base, link.href);
        return (
          <a
            href={link.href === '/' ? base : `${base}${link.href.replace(/^\//, '')}/`}
            data-href={link.href}
            class="nav-item text-base"
            data-active={String(active)}
            data-astro-prefetch="load"
          >
            <Icon size={19} strokeWidth={active ? 2.4 : 2} />
            <span>{link.label}</span>
          </a>
        );
      })}
    </nav>
  </div>
</div>

<script>
  function getDrawerElements() {
    return {
      drawer: document.getElementById('mobile-drawer'),
      panel: document.getElementById('drawer-panel'),
      backdrop: document.getElementById('drawer-backdrop'),
      openBtn: document.getElementById('drawer-open'),
    };
  }

  function setDrawerOpen(open: boolean) {
    const { drawer, panel, backdrop, openBtn } = getDrawerElements();
    if (!drawer || !panel || !backdrop) return;
    if (open) {
      drawer.classList.remove('pointer-events-none');
      panel.classList.remove('-translate-x-full');
      backdrop.classList.remove('opacity-0');
      openBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    } else {
      drawer.classList.add('pointer-events-none');
      panel.classList.add('-translate-x-full');
      backdrop.classList.add('opacity-0');
      openBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  }

  // Exponer globalmente
  (window as any).__setMoriscosDrawer = setDrawerOpen;

  function updateActiveNav() {
    const currentPath = window.location.pathname;
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const drawerLinks = document.querySelectorAll('#mobile-nav-list a');
    drawerLinks.forEach((link) => {
      const linkHref = link.getAttribute('data-href') || '';
      const normalizedHref = (base + linkHref).replace(/\/$/, '');
      const normalizedCurrent = currentPath.replace(/\/$/, '');
      const isActive = linkHref === '/'
        ? normalizedCurrent === base || normalizedCurrent === ''
        : normalizedCurrent.startsWith(normalizedHref);
      link.setAttribute('data-active', String(isActive));
    });
  }

  // Delegación global de eventos sobre document: NUNCA se desengancha ni pierde eventos
  if (!(window as any).__moriscos_drawer_delegated) {
    (window as any).__moriscos_drawer_delegated = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      if (target.closest('#drawer-open')) {
        e.preventDefault();
        setDrawerOpen(true);
        return;
      }

      if (target.closest('#drawer-close') || target.id === 'drawer-backdrop') {
        e.preventDefault();
        setDrawerOpen(false);
        return;
      }

      if (target.closest('#mobile-nav-list a')) {
        setDrawerOpen(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setDrawerOpen(false);
    });

    const EDGE_EXCLUSION_PX = 30;
    const SWIPE_THRESHOLD_PX = 40;
    const isMobileViewport = () => !window.matchMedia('(min-width: 1024px)').matches;

    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartOnMap = false;

    document.addEventListener(
      'touchstart',
      (e) => {
        const t = e.touches[0];
        touchStartX = t.clientX;
        touchStartY = t.clientY;
        touchStartOnMap = !!(e.target as HTMLElement)?.closest?.('.leaflet-container');
      },
      { passive: true },
    );

    document.addEventListener(
      'touchend',
      (e) => {
        if (!isMobileViewport() || touchStartOnMap) return;
        const t = e.changedTouches[0];
        const deltaX = t.clientX - touchStartX;
        const deltaY = t.clientY - touchStartY;
        if (Math.abs(deltaX) < SWIPE_THRESHOLD_PX || Math.abs(deltaX) <= Math.abs(deltaY)) return;
        if (deltaX > 0) {
          if (touchStartX > EDGE_EXCLUSION_PX) {
            setDrawerOpen(true);
          }
        } else {
          setDrawerOpen(false);
        }
      },
      { passive: true },
    );
  }

  // Al completar la navegación, actualizar estado visual y asegurar que el drawer esté cerrado
  document.addEventListener('DOMContentLoaded', updateActiveNav);
  document.addEventListener('astro:page-load', () => {
    setDrawerOpen(false);
    updateActiveNav();
  });
  document.addEventListener('astro:after-swap', () => {
    setDrawerOpen(false);
    updateActiveNav();
  });
</script>
