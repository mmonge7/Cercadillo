---
export interface Props {
  title: string;
  year: string;
  summary: string;
  href: string;
}
const { title, year, summary, href } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a
  href={base + href.replace(/^\//, '')}
  class="group flex flex-col rounded-2xl border border-piedra-border/60 bg-pergamino p-6 transition-all hover:-translate-y-1 hover:border-piedra-300 hover:shadow-xl hover:shadow-piedra-200/30 dark:border-noche-border dark:bg-noche-surface dark:hover:shadow-none"
>
  <span class="kicker">{year}</span>
  <h3 class="mt-2 font-serif text-xl font-semibold text-armuna-dark dark:text-piedra-200">{title}</h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-tinta/70 dark:text-pergamino-muted/70">{summary}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-soto dark:text-piedra-300">
    Leer más
    <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </span>
</a>
