---
---

<button
  id="theme-toggle"
  type="button"
  class="relative inline-flex h-10 w-10 items-center justify-center rounded-full text-tinta/80 hover:bg-piedra-50 dark:text-pergamino-muted/80 dark:hover:bg-noche-surface"
  aria-label="Cambiar entre modo claro y modo noche"
>
  <svg id="icon-sun" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
  </svg>
  <svg id="icon-moon" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/>
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  const sun = document.getElementById('icon-sun');
  const moon = document.getElementById('icon-moon');

  const sync = () => {
    const isDark = document.documentElement.classList.contains('dark');
    sun?.classList.toggle('hidden', isDark);
    moon?.classList.toggle('hidden', !isDark);
  };

  sync();

  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('moriscos-theme', isDark ? 'dark' : 'light');
    sync();
  });
</script>
