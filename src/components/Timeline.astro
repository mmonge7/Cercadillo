---
export interface TimelineEvent {
  year: string;
  text: string;
  href?: string;
}

export interface Props {
  events: TimelineEvent[];
}

const { events } = Astro.props;
---

<div class="relative space-y-7 before:absolute before:bottom-8 before:left-[19px] before:top-8 before:w-[3px] before:rounded-full before:bg-gradient-to-b before:from-piedra-300 before:via-piedra-500 before:to-armuna-light sm:before:left-[23px]">
  {events.map((e) => {
    const isLink = Boolean(e.href);
    const Tag = isLink ? 'a' : 'div';
    return (
      <div class="group relative flex items-center pl-14 sm:pl-20">
        {/* Punto / Nodo de hito cronológico centrado verticalmente con la tarjeta */}
        <div class="absolute left-0 top-1/2 -translate-y-1/2 z-10 flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center rounded-full border-2 border-piedra-400 bg-noche-surface shadow-lg shadow-black/40 ring-4 ring-noche transition-all duration-300 group-hover:scale-110 group-hover:border-gold group-hover:shadow-piedra-400/30">
          <span class="h-3.5 w-3.5 sm:h-4 sm:w-4 rounded-full bg-gradient-to-tr from-armuna to-piedra-300 transition-all duration-300 group-hover:from-piedra-300 group-hover:to-gold" />
        </div>

        {/* Conector horizontal centrado exactamente entre el círculo y la tarjeta */}
        <div class="absolute left-10 sm:left-12 top-1/2 -translate-y-1/2 h-[2px] w-4 sm:w-8 bg-piedra-400/60 transition-colors duration-300 group-hover:bg-gold" />

        {/* Tarjeta de contenido del hito */}
        <Tag
          {...(isLink ? { href: e.href } : {})}
          class:list={[
            'w-full rounded-2xl border border-noche-border/90 bg-noche-surface/90 p-5 shadow-md transition-all duration-200 sm:p-6',
            isLink
              ? 'block cursor-pointer hover:-translate-y-0.5 hover:border-piedra-400/70 hover:bg-noche-surface hover:shadow-xl hover:shadow-black/40'
              : 'block',
          ]}
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="inline-flex items-center gap-2 rounded-full border border-piedra-400/40 bg-piedra-400/15 px-4 py-1.5 font-display text-sm sm:text-base font-bold tracking-wider text-piedra-200 shadow-sm">
              <span class="inline-block h-2 w-2 rounded-full bg-piedra-400" />
              {e.year}
            </span>
            {isLink && (
              <span class="inline-flex items-center gap-1.5 font-body text-xs sm:text-sm font-semibold text-piedra-300 transition-colors group-hover:text-gold">
                <span>Ver capítulo relacionado</span>
                <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </span>
            )}
          </div>
          <p class="mt-3 font-body text-sm leading-relaxed text-pergamino-muted/95 sm:text-base">
            {e.text}
          </p>
        </Tag>
      </div>
    );
  })}
</div>
