---
export interface TimelineEvent {
  year: string;
  text: string;
  href?: string;
}

export interface Props {
  events: TimelineEvent[];
}

const { events } = Astro.props;
---

<div class="relative space-y-6 before:absolute before:bottom-4 before:left-[17px] before:top-4 before:w-0.5 before:bg-gradient-to-b before:from-piedra-300 before:via-piedra-500 before:to-armuna-light sm:before:left-[21px]">
  {events.map((e) => {
    const isLink = Boolean(e.href);
    const Tag = isLink ? 'a' : 'div';
    return (
      <div class="group relative flex items-start pl-11 sm:pl-14">
        {/* Nodo / Punto de hito */}
        <div class="absolute left-0 top-1.5 flex h-9 w-9 items-center justify-center rounded-full border-2 border-piedra-400/90 bg-noche shadow-md shadow-piedra-400/15 transition-all duration-300 group-hover:scale-110 group-hover:border-gold group-hover:shadow-piedra-400/40 sm:h-11 sm:w-11">
          <span class="h-2.5 w-2.5 rounded-full bg-armuna transition-colors duration-300 group-hover:bg-gold dark:bg-piedra-300 sm:h-3 sm:w-3" />
        </div>

        {/* Tarjeta del hito */}
        <Tag
          {...(isLink ? { href: e.href } : {})}
          class:list={[
            'w-full rounded-2xl border border-noche-border bg-noche-surface/85 p-4 shadow-md transition-all duration-200 sm:p-5',
            isLink
              ? 'block cursor-pointer hover:-translate-y-0.5 hover:border-piedra-400/60 hover:bg-noche-surface hover:shadow-lg hover:shadow-black/30'
              : 'block',
          ]}
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="inline-flex items-center rounded-full border border-piedra-400/30 bg-piedra-400/15 px-3 py-0.5 font-display text-xs font-bold tracking-wider text-piedra-200 sm:text-sm">
              {e.year}
            </span>
            {isLink && (
              <span class="inline-flex items-center gap-1 font-body text-xs font-semibold text-piedra-400 transition-colors group-hover:text-piedra-200">
                <span>Ver en detalle</span>
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </span>
            )}
          </div>
          <p class="mt-2.5 font-body text-sm leading-relaxed text-pergamino-muted/90 sm:text-[0.925rem]">
            {e.text}
          </p>
        </Tag>
      </div>
    );
  })}
</div>
