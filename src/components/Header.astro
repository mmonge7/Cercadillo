---
import { Menu } from 'lucide-react';
import { navLinks } from '../data/site';
import { isActiveHref } from '../utils/nav';
import SearchModal from './SearchModal';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const activeLink = navLinks.find((link) => isActiveHref(path, base, link.href));
---

<header
  class="fixed inset-x-0 top-0 z-40 flex h-[var(--mobile-topbar)] items-center border-b border-piedra-border/60 bg-pergamino/85 backdrop-blur-md dark:border-noche-border dark:bg-noche/85 lg:sticky lg:left-[230px] lg:h-[68px] lg:w-[calc(100%-230px)]"
>
  <div class="flex w-full items-center justify-between gap-4 px-4 pt-[env(safe-area-inset-top,0px)] sm:px-6">
    <div class="flex items-center gap-3">
      <button
        id="drawer-open"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-tinta/80 hover:bg-piedra-50 dark:text-pergamino-muted/80 dark:hover:bg-noche-surface lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <Menu size={21} strokeWidth={1.8} />
      </button>
      <a href={base} class="font-display text-base font-bold tracking-wide text-armuna-dark dark:text-piedra-200 lg:hidden">
        MORISCOS
      </a>
      <span class="hidden font-body text-sm font-semibold text-tinta/80 dark:text-pergamino-muted/80 lg:inline">
        {activeLink?.label ?? 'Inicio'}
      </span>
    </div>

    <div class="flex items-center gap-1.5">
      <SearchModal client:idle />
      <ThemeToggle />
    </div>
  </div>
</header>

