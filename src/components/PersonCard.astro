---
export interface Props {
  id: string;
  name: string;
  years: string;
  role: string;
  tag: string;
}
const { id, name, years, role, tag } = Astro.props;
---

<article id={id} class="scroll-mt-24 rounded-2xl border border-piedra-border/60 bg-pergamino p-6 dark:border-noche-border dark:bg-noche-surface">
  <div class="flex items-start justify-between gap-3">
    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-armuna/10 font-display text-lg text-armuna-dark dark:bg-piedra-300/10 dark:text-piedra-200">
      {name.charAt(0)}
    </div>
    <span class="rounded-full bg-soto/10 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-soto dark:bg-piedra-300/10 dark:text-piedra-300">
      {tag}
    </span>
  </div>
  <h3 class="mt-4 font-serif text-lg font-semibold text-tinta dark:text-pergamino-muted">{name}</h3>
  <p class="text-sm font-medium text-armuna dark:text-piedra-300">{years}</p>
  <p class="mt-2 text-sm leading-relaxed text-tinta/70 dark:text-pergamino-muted/70">{role}</p>
  <div class="mt-4 border-t border-piedra-border/60 pt-4 text-sm leading-relaxed text-tinta/75 dark:border-noche-border dark:text-pergamino-muted/75">
    <slot />
  </div>
</article>
