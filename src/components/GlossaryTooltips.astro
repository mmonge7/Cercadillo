---
import { getCollection } from 'astro:content';

const glosario = await getCollection('glosario');
const base = import.meta.env.BASE_URL;
const terms = glosario.map((g) => ({ term: g.data.term, short: g.data.short, href: `${base}glosario#${g.id}` }));
---

<script type="application/json" id="glossary-terms" set:html={JSON.stringify(terms)} />

<div
  id="glossary-tooltip"
  role="tooltip"
  class="pointer-events-none fixed z-[90] hidden w-72 max-w-[85vw] rounded-xl border border-piedra-border/60 bg-pergamino p-4 text-sm shadow-2xl dark:border-noche-border dark:bg-noche-surface"
>
  <p id="glossary-tooltip-term" class="font-serif text-base font-semibold italic text-armuna-dark dark:text-piedra-200"></p>
  <p id="glossary-tooltip-short" class="mt-1 text-tinta/75 dark:text-pergamino-muted/75"></p>
  <a id="glossary-tooltip-link" href="#" class="pointer-events-auto mt-2 inline-flex items-center gap-1 text-xs font-semibold text-soto hover:underline dark:text-piedra-300">
    Ver en el glosario &rarr;
  </a>
</div>

<script>
  type GlossaryTerm = { term: string; short: string; href: string };

  const dataEl = document.getElementById('glossary-terms');
  const terms: GlossaryTerm[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
  const prose = document.querySelector('.prose-armuna');
  const tooltip = document.getElementById('glossary-tooltip');
  const tooltipTerm = document.getElementById('glossary-tooltip-term');
  const tooltipShort = document.getElementById('glossary-tooltip-short');
  const tooltipLink = document.getElementById('glossary-tooltip-link') as HTMLAnchorElement | null;

  if (prose && tooltip && terms.length) {
    const skipTags = new Set(['SCRIPT', 'STYLE', 'A', 'BUTTON', 'H1', 'H2', 'H3', 'H4']);
    const used = new Set<string>();

    for (const t of terms) {
      if (used.has(t.term)) continue;
      const regex = new RegExp(`\\b(${t.term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})\\b`, 'i');

      const walker = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT);
      let found = false;
      const nodes: Text[] = [];
      let node: Node | null;
      // eslint-disable-next-line no-cond-assign
      while ((node = walker.nextNode())) {
        if (node.parentElement && skipTags.has(node.parentElement.tagName)) continue;
        nodes.push(node as Text);
      }

      for (const textNode of nodes) {
        const match = textNode.data.match(regex);
        if (!match || match.index === undefined) continue;

        const before = textNode.data.slice(0, match.index);
        const matched = match[0];
        const after = textNode.data.slice(match.index + matched.length);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className =
          'glossary-term rounded-sm border-b-2 border-dotted border-piedra-400 font-medium text-armuna-dark decoration-piedra-400 hover:bg-piedra-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-piedra-400 dark:border-piedra-500 dark:text-piedra-200 dark:hover:bg-noche';
        btn.textContent = matched;
        btn.dataset.term = t.term;
        btn.dataset.short = t.short;
        btn.dataset.href = t.href;
        btn.setAttribute('aria-describedby', 'glossary-tooltip');

        const parent = textNode.parentNode;
        if (!parent) continue;
        const afterNode = document.createTextNode(after);
        parent.insertBefore(document.createTextNode(before), textNode);
        parent.insertBefore(btn, textNode);
        parent.insertBefore(afterNode, textNode);
        parent.removeChild(textNode);

        found = true;
        break;
      }
      if (found) used.add(t.term);
    }

    const hideTooltip = () => {
      tooltip.classList.add('hidden');
    };

    const showTooltip = (btn: HTMLElement) => {
      if (tooltipTerm) tooltipTerm.textContent = btn.dataset.term ?? '';
      if (tooltipShort) tooltipShort.textContent = btn.dataset.short ?? '';
      if (tooltipLink) tooltipLink.href = btn.dataset.href ?? '#';

      const rect = btn.getBoundingClientRect();
      tooltip.classList.remove('hidden');
      const tw = tooltip.offsetWidth;
      let left = rect.left + rect.width / 2 - tw / 2;
      left = Math.max(12, Math.min(left, window.innerWidth - tw - 12));
      const top = rect.bottom + 10;
      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${top}px`;
      tooltip.classList.remove('pointer-events-none');
    };

    let pinnedBtn: HTMLElement | null = null;

    document.querySelectorAll('.glossary-term').forEach((btn) => {
      btn.addEventListener('mouseenter', () => {
        if (!pinnedBtn) showTooltip(btn as HTMLElement);
      });
      btn.addEventListener('focus', () => {
        if (!pinnedBtn) showTooltip(btn as HTMLElement);
      });
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (pinnedBtn === btn) {
          pinnedBtn = null;
          hideTooltip();
        } else {
          pinnedBtn = btn as HTMLElement;
          showTooltip(btn as HTMLElement);
        }
      });
      btn.addEventListener('mouseleave', () => {
        setTimeout(() => {
          if (!pinnedBtn && !tooltip.matches(':hover')) hideTooltip();
        }, 150);
      });
      btn.addEventListener('blur', () => {
        if (!pinnedBtn) hideTooltip();
      });
    });

    document.addEventListener('click', (e) => {
      if (pinnedBtn && !(e.target as HTMLElement).closest('.glossary-term') && !(e.target as HTMLElement).closest('#glossary-tooltip')) {
        pinnedBtn = null;
        hideTooltip();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        pinnedBtn = null;
        hideTooltip();
      }
    });
    window.addEventListener('scroll', hideTooltip, { passive: true });
  }
</script>
