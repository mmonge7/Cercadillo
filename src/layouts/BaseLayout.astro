---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileDrawer from '../components/MobileDrawer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-pt-24">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}icons/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}icons/apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#8C4A32" />
    <SEO title={title} description={description} image={image} />
    <script is:inline>
      // Evita que el navegador (sobre todo en móvil) restaure el scroll de la
      // página anterior al navegar a una nueva sección: cada página empieza
      // arriba del todo, salvo que la URL lleve un #ancla (p. ej. un enlace
      // del buscador o del índice de un capítulo), que sí debe desplazarse.
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      if (!location.hash) {
        window.scrollTo(0, 0);
      }
      window.addEventListener('pageshow', function () {
        if (!location.hash) window.scrollTo(0, 0);
      });
    </script>
    <script is:inline>
      (function () {
        // Modo oscuro por defecto: solo se queda en claro si el propio
        // visitante lo cambió antes (no depende de la preferencia del sistema).
        var stored = localStorage.getItem('moriscos-theme');
        var theme = stored || 'dark';
        if (theme === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="paper-texture min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded focus:bg-soto focus:px-4 focus:py-2 focus:text-pergamino">
      Saltar al contenido principal
    </a>
    <Sidebar />
    <MobileDrawer />
    <div class="flex min-h-screen flex-col pt-[var(--mobile-topbar)] lg:pt-0 lg:pl-[230px]">
      <Header />
      <main id="main" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    <a
      href="https://github.com/pCresp0/moriscos-wiki"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contador de visitas de la web"
      class="fixed bottom-20 right-4 z-30 opacity-60 shadow-md transition-opacity hover:opacity-100 lg:bottom-4"
    >
      <img
        src="https://visitor-badge.laobi.icu/badge?page_id=pcresp0.moriscos-wiki&left_text=visitas&left_color=2A241D&right_color=8C4A32&radius=8&format=true"
        alt="Contador de visitas"
        width="90"
        height="20"
        loading="lazy"
        class="block h-4 w-auto rounded-md sm:h-5"
      />
    </a>

    <div
      id="global-error-banner"
      role="alert"
      class="fixed inset-x-4 bottom-4 z-[100] hidden max-w-md rounded-2xl border border-piedra-border/60 bg-pergamino p-4 text-sm text-tinta shadow-2xl sm:inset-x-auto sm:right-4 dark:border-noche-border dark:bg-noche-surface dark:text-pergamino-muted"
    >
      <div class="flex items-start gap-3">
        <span aria-hidden="true">⚠️</span>
        <p class="flex-1">
          Ha ocurrido un error inesperado en una parte de la página, pero puedes seguir usando el resto de la web con
          normalidad.
        </p>
        <button
          id="global-error-dismiss"
          type="button"
          aria-label="Cerrar aviso"
          class="shrink-0 rounded-full p-1 hover:bg-piedra-50 dark:hover:bg-noche"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <script>
      // Red de seguridad global: si algo revienta fuera de una isla React (p. ej.
      // un script suelto), se avisa sin bloquear ni romper el resto de la página.
      (function () {
        const banner = document.getElementById('global-error-banner');
        const dismiss = document.getElementById('global-error-dismiss');
        if (!banner) return;

        let shown = false;
        const show = (error: unknown) => {
          console.error('[global-error]', error);
          if (shown) return;
          shown = true;
          banner.classList.remove('hidden');
        };

        window.addEventListener('error', (e) => show(e.error ?? e.message));
        window.addEventListener('unhandledrejection', (e) => show(e.reason));
        dismiss?.addEventListener('click', () => banner.classList.add('hidden'));
      })();
    </script>

    <script>
      // Registra el service worker (generado por workbox en el build de producción)
      // para instalar la PWA y servir el sitio offline tras la primera visita.
      if ('serviceWorker' in navigator) {
        const base = import.meta.env.BASE_URL;
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).catch(() => {
            // en `astro dev` no existe sw.js: es esperado y no requiere acción.
          });
        });
      }
    </script>
  </body>
</html>


