---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import ScrollToTopButton from '../components/ScrollToTopButton';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-pt-24 dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}icons/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}icons/favicon-16.png`} />
    <link rel="shortcut icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}icons/apple-touch-icon.png`} />
    <link rel="apple-touch-icon" sizes="167x167" href={`${import.meta.env.BASE_URL}icons/apple-touch-icon-167x167.png`} />
    <link rel="apple-touch-icon" sizes="152x152" href={`${import.meta.env.BASE_URL}icons/apple-touch-icon-152x152.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <meta name="apple-mobile-web-app-title" content="Moriscos" />
    <meta name="application-name" content="Moriscos" />
    <meta name="msapplication-TileColor" content="#2a241d" />
    <meta name="msapplication-TileImage" content={`${import.meta.env.BASE_URL}icons/icon-192.png`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#724828" />
    <SEO title={title} description={description} image={image} />
    <ClientRouter />
    <script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
      // 1. Al recargar o actualizar la web (F5, reload), vuelve a la portada de inicio por defecto
      try {
        var navEntry = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var isReload = (navEntry && navEntry.type === 'reload') ||
                       (performance.navigation && performance.navigation.type === 1);
        var normPath = location.pathname.endsWith('/') ? location.pathname : location.pathname + '/';
        var normBase = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
        if (isReload && normPath !== normBase) {
          window.location.replace(baseUrl);
        }
      } catch (_) {}

      // 2. Al acceder o navegar a cualquier apartado, arranca siempre arriba del todo
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      function resetScrollTop() {
        if (!location.hash) {
          window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
          if (document.documentElement) document.documentElement.scrollTop = 0;
          if (document.body) document.body.scrollTop = 0;
        }
      }
      resetScrollTop();
      window.addEventListener('pageshow', resetScrollTop);
      window.addEventListener('DOMContentLoaded', resetScrollTop);
      document.addEventListener('astro:after-swap', resetScrollTop);
      document.addEventListener('astro:page-load', resetScrollTop);

      // 3. Precarga total en memoria RAM (0ms): descarga todas las páginas en segundo plano
      // nada más abrir la web. Al pulsar cualquier apartado del menú, se monta al instante desde memoria.
      (function () {
        if (typeof window === 'undefined') return;
        if (!window.__MORISCOS_CACHE__) {
          window.__MORISCOS_CACHE__ = new Map();
        }

        var base = baseUrl.replace(/\/$/, '') + '/';
        var pages = [
          '',
          'escudo',
          'fiestas',
          'genealogia',
          'glosario',
          'historia',
          'iglesia',
          'libro',
          'libro/01-marco-geografico',
          'libro/02-toponimia-repoblacion',
          'libro/03-geografia-rural',
          'libro/04-economia-tradicional',
          'libro/05-despoblado-ribas-flecha',
          'libro/06-conflictos-belicos',
          'libro/07-sucesos-cronica-negra',
          'libro/08-evolucion-infraestructural',
          'libro/09-glosario-anexos',
          'libro/10-epilogo-fuentes',
          'libro/11-portal-morisquenos',
          'lugares',
          'referencias',
          'ruta-nocturna',
          'sobre-la-web'
        ];

        function normalizeKey(urlStr) {
          try {
            var u = new URL(urlStr, window.location.origin);
            return u.pathname.replace(/\/$/, '') || '/';
          } catch (_) {
            return String(urlStr).replace(/\/$/, '') || '/';
          }
        }

        function preloadAll() {
          var parser = new DOMParser();
          pages.forEach(function (route) {
            var fullUrl = base + route;
            var key = normalizeKey(fullUrl);
            if (window.__MORISCOS_CACHE__.has(key)) return;

            fetch(fullUrl, { priority: 'high', cache: 'force-cache' })
              .then(function (res) {
                if (res.ok) return res.text();
              })
              .then(function (html) {
                if (html) {
                  var doc = parser.parseFromString(html, 'text/html');
                  window.__MORISCOS_CACHE__.set(key, doc);
                  window.__MORISCOS_CACHE__.set(fullUrl, doc);
                }
              })
              .catch(function () {});
          });
        }

        // Iniciar precarga de forma inmediata en milisegundo 0
        preloadAll();
        if (typeof requestIdleCallback !== 'undefined') {
          requestIdleCallback(preloadAll);
        }

        // Al pulsar un enlace, Astro toma directamente el DOM desde la RAM sin esperar peticiones
        document.addEventListener('astro:before-preparation', function (event) {
          if (!event.to) return;
          var targetKey = normalizeKey(event.to.href || event.to.pathname);
          var cachedDoc = window.__MORISCOS_CACHE__.get(targetKey);
          if (cachedDoc) {
            event.newDocument = cachedDoc.cloneNode(true);
            event.loader = function () {
              return Promise.resolve();
            };
          }
        });
      })();
    </script>
    <script is:inline>
      (function () {
        // Tema permanente: diseño optimizado exclusivamente en modo noche
        // inspirado en la tierra y el trigo de La Armuña.
        document.documentElement.classList.add('dark');
        try {
          localStorage.setItem('moriscos-theme', 'dark');
        } catch (_) {}
      })();
      document.addEventListener('astro:after-swap', function () {
        document.documentElement.classList.add('dark');
      });
    </script>
  </head>
  <body class="paper-texture min-h-screen" transition:animate="none">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded focus:bg-soto focus:px-4 focus:py-2 focus:text-pergamino">
      Saltar al contenido principal
    </a>
    <Header />
    <Sidebar />
    <MobileDrawer />
    <div class="flex min-h-screen flex-col pt-[var(--mobile-topbar)] lg:pt-[72px] lg:pl-[230px]">
      <main id="main" class="flex-1" transition:animate="none">
        <slot />
      </main>
      <Footer />
    </div>

    <ScrollToTopButton client:idle resetKey={Astro.url.pathname} />

    <div
      id="global-error-banner"
      role="alert"
      class="fixed inset-x-4 bottom-4 z-[100] hidden max-w-md rounded-2xl border border-piedra-border/60 bg-pergamino p-4 text-sm text-tinta shadow-2xl sm:inset-x-auto sm:right-4 dark:border-noche-border dark:bg-noche-surface dark:text-pergamino-muted"
    >
      <div class="flex items-start gap-3">
        <span aria-hidden="true">⚠️</span>
        <p class="flex-1">
          Ha ocurrido un error inesperado en una parte de la página, pero puedes seguir usando el resto de la web con
          normalidad.
        </p>
        <button
          id="global-error-dismiss"
          type="button"
          aria-label="Cerrar aviso"
          class="shrink-0 rounded-full p-1 hover:bg-piedra-50 dark:hover:bg-noche"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <script>
      // Red de seguridad global: si algo revienta fuera de una isla React (p. ej.
      // un script suelto), se avisa sin bloquear ni romper el resto de la página.
      (function () {
        const banner = document.getElementById('global-error-banner');
        const dismiss = document.getElementById('global-error-dismiss');
        if (!banner) return;

        let shown = false;
        const show = (error: unknown) => {
          console.error('[global-error]', error);
          if (shown) return;
          shown = true;
          banner.classList.remove('hidden');
        };

        window.addEventListener('error', (e) => show(e.error ?? e.message));
        window.addEventListener('unhandledrejection', (e) => show(e.reason));
        dismiss?.addEventListener('click', () => banner.classList.add('hidden'));
      })();
    </script>

    <script>
      // Localizador y resaltado visual de coincidencias del buscador
      (function () {
        const params = new URLSearchParams(window.location.search);
        const highlightQuery = params.get('highlight');
        if (!highlightQuery) return;

        const term = highlightQuery.trim();
        if (term.length < 2) return;

        function runHighlight() {
          const main = document.getElementById('main') || document.querySelector('main');
          if (!main) return;

          const walker = document.createTreeWalker(
            main,
            NodeFilter.SHOW_TEXT,
            {
              acceptNode(node) {
                const parent = node.parentElement;
                if (!parent) return NodeFilter.FILTER_REJECT;
                const tag = parent.tagName.toLowerCase();
                if (['script', 'style', 'button', 'input', 'textarea', 'svg', 'noscript'].includes(tag)) {
                  return NodeFilter.FILTER_REJECT;
                }
                if (parent.closest('#search-modal, .search-match-highlight')) {
                  return NodeFilter.FILTER_REJECT;
                }
                return NodeFilter.FILTER_ACCEPT;
              },
            }
          );

          const matches: Text[] = [];
          const regex = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');

          let node: Node | null;
          while ((node = walker.nextNode())) {
            if (node.nodeValue && regex.test(node.nodeValue)) {
              matches.push(node as Text);
            }
          }

          let firstMark: HTMLElement | null = null;

          matches.forEach((textNode) => {
            const text = textNode.nodeValue || '';
            const frag = document.createDocumentFragment();
            let lastIdx = 0;
            text.replace(regex, (match, _p1, offset) => {
              frag.appendChild(document.createTextNode(text.slice(lastIdx, offset)));
              const mark = document.createElement('mark');
              mark.className = 'search-match-highlight';
              mark.textContent = match;
              if (!firstMark) firstMark = mark;
              frag.appendChild(mark);
              lastIdx = offset + match.length;
              return match;
            });
            frag.appendChild(document.createTextNode(text.slice(lastIdx)));
            if (textNode.parentNode) {
              textNode.parentNode.replaceChild(frag, textNode);
            }
          });

          // Si la URL no apunta a un #hash específico, hace scroll suave a la primera coincidencia
          const hasHash = !!window.location.hash;
          if (firstMark && !hasHash) {
            setTimeout(() => {
              (firstMark as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 180);
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => setTimeout(runHighlight, 80));
        } else {
          setTimeout(runHighlight, 80);
        }
        document.addEventListener('astro:page-load', () => setTimeout(runHighlight, 80));
      })();
    </script>

    <script>
      // Registra el service worker (generado por workbox en el build de producción)
      // para instalar la PWA y servir el sitio offline tras la primera visita.
      if ('serviceWorker' in navigator) {
        const base = import.meta.env.BASE_URL;
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(`${base}sw.js`, { scope: base })
            .then((reg) => {
              reg.update();
            })
            .catch(() => {
              // en `astro dev` no existe sw.js: es esperado y no requiere acción.
            });
        });
      }
    </script>
  </body>
</html>


